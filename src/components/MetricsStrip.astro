---
import { metricsData } from "../data/portfolioData";
---

<div class="metrics-strip">
  {
    metricsData.map((metric) => (
      <div class="metric-card glass-card spotlight-card">
        <div class="metric-header">
          <span class="metric-value accent-gradient-text">{metric.value}</span>
          <div class="metric-icon-wrap">
            {metric.icon === "clock" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            )}
            {metric.icon === "zap" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            )}
            {metric.icon === "users" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            )}
            {metric.icon === "gauge" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4"></path>
                <path d="m4.93 4.93 2.83 2.83"></path>
                <path d="M2 12h4"></path>
                <path d="m4.93 19.07 2.83-2.83"></path>
                <path d="M12 22v-4"></path>
                <path d="m19.07 19.07-2.83-2.83"></path>
                <path d="M22 12h-4"></path>
                <path d="m19.07 4.93-2.83 2.83"></path>
              </svg>
            )}
          </div>
        </div>
        <div class="metric-body">
          <span class="metric-label">{metric.label}</span>
          <span class="metric-sublabel">{metric.sublabel}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0 3rem 0;
  }

  .metric-card {
    padding: 1.35rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
  }

  .metric-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .metric-value {
    font-size: 2.2rem;
    font-weight: 800;
    font-family: var(--font-sans);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .metric-icon-wrap {
    color: var(--accent-cyan);
    opacity: 0.85;
    background: var(--accent-cyan-glow);
    padding: 6px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-label {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .metric-sublabel {
    font-size: 0.785rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .metrics-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 500px) {
    .metrics-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
