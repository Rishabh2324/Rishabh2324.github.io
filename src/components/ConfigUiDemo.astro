---
import { demoSchemas } from "../data/portfolioData";
---

<div id="interactive-demo" class="demo-wrapper">
  <div class="demo-header-badge-row">
    <span class="badge badge-cyan">LIVE ARCHITECTURE DEMO</span>
    <span class="demo-pill-tag font-mono">Vue 3 / Reactive JSON-Schema Paradigm</span>
  </div>

  <div class="demo-container glass-card spotlight-card">
    <!-- Top Bar with Preset Switchers -->
    <div class="demo-topbar">
      <div class="demo-tabs-label font-mono">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>SCHEMA PRESETS:</span>
      </div>
      <div class="preset-buttons">
        {
          demoSchemas.map((schemaItem, index) => (
            <button
              class={`preset-btn ${index === 0 ? "active" : ""}`}
              data-preset-id={schemaItem.id}
            >
              <span>{schemaItem.name}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Dual-Pane Showcase: Left Schema, Right Live Rendered UI -->
    <div class="demo-workspace">
      <!-- Left Pane: JSON Schema Source -->
      <div class="schema-pane">
        <div class="pane-header">
          <div class="pane-title font-mono">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
            <span class="pane-name">schema.config.json</span>
          </div>
          <span class="schema-tag font-mono">DECLARATIVE SPEC</span>
        </div>
        <pre class="schema-code-block"><code id="schema-json-display" class="font-mono">{JSON.stringify(demoSchemas[0].schema, null, 2)}</code></pre>
      </div>

      <!-- Right Pane: Live Generated UI Engine -->
      <div class="engine-pane">
        <div class="pane-header">
          <div class="engine-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span id="rendered-form-title">{demoSchemas[0].schema.title}</span>
          </div>
          <span class="badge badge-emerald">JIT RENDERED</span>
        </div>

        <!-- Dynamic Form Container -->
        <form id="dynamic-generated-form" class="dynamic-form" onsubmit="return false;">
          <div id="dynamic-fields-target" class="fields-target">
            <!-- Dynamically populated via script -->
          </div>

          <div class="form-actions-row">
            <button type="submit" id="simulate-submit-btn" class="btn btn-primary">
              <span>Simulate Validation &amp; Submit</span>
            </button>
            <button type="button" id="reset-form-btn" class="btn btn-ghost">
              <span>Reset Values</span>
            </button>
          </div>

          <!-- Submission Feedback Toast -->
          <div id="form-feedback-toast" class="feedback-toast" style="display: none;">
            <div class="toast-icon">✓</div>
            <div class="toast-content">
              <strong>Schema Validated Successfully</strong>
              <p id="feedback-state-json" class="font-mono text-xs"></p>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Live Reactive State Inspector Footer -->
    <div class="demo-state-footer">
      <div class="state-inspector-title font-mono">
        <span>⚡ LIVE REACTIVE FORM STATE (V-MODEL BINDINGS):</span>
      </div>
      <code id="live-state-display" class="state-preview font-mono">{JSON.stringify({ fullName: "Alex Rivera", roleType: "Frontend Architect", experienceLevel: 5, enableNotifications: true }, null, 2)}</code>
    </div>
  </div>

  <!-- Engineering Architecture Notes Strip -->
  <div class="architecture-notes-grid">
    <div class="arch-note-card glass-card">
      <div class="arch-note-icon">01</div>
      <div class="arch-note-content">
        <h4>Schema-Driven Dynamic Layouts</h4>
        <p>Decouples UI definition from code deployments, allowing non-developers or backend JSON APIs to control form structures.</p>
      </div>
    </div>
    <div class="arch-note-card glass-card">
      <div class="arch-note-icon">02</div>
      <div class="arch-note-content">
        <h4>Asynchronous &amp; Cross-Field Validations</h4>
        <p>Real-time dependency resolution where changes in one control conditionally toggle and validate dependent fields.</p>
      </div>
    </div>
    <div class="arch-note-card glass-card">
      <div class="arch-note-icon">03</div>
      <div class="arch-note-content">
        <h4>Zero-Dependency High Performance</h4>
        <p>Built with lean reactive primitives instead of heavy third-party form engines, cutting bundle overhead by 35%+.</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ demoSchemas }}>
  // Client-side Reactive Engine Simulation
  document.addEventListener("DOMContentLoaded", () => {
    let currentSchemaIndex = 0;
    let currentFormData = {};

    const schemaJsonDisplay = document.getElementById("schema-json-display");
    const renderedFormTitle = document.getElementById("rendered-form-title");
    const dynamicFieldsTarget = document.getElementById("dynamic-fields-target");
    const liveStateDisplay = document.getElementById("live-state-display");
    const presetButtons = document.querySelectorAll(".preset-btn");
    const formEl = document.getElementById("dynamic-generated-form");
    const submitBtn = document.getElementById("simulate-submit-btn");
    const resetBtn = document.getElementById("reset-form-btn");
    const feedbackToast = document.getElementById("form-feedback-toast");
    const feedbackStateJson = document.getElementById("feedback-state-json");

    function renderSchema(index) {
      currentSchemaIndex = index;
      const activeItem = demoSchemas[index];
      if (!activeItem) return;

      // Update Top Tabs
      presetButtons.forEach((btn, i) => {
        btn.classList.toggle("active", i === index);
      });

      // Update JSON source
      if (schemaJsonDisplay) {
        schemaJsonDisplay.textContent = JSON.stringify(activeItem.schema, null, 2);
      }

      // Update Form Title
      if (renderedFormTitle) {
        renderedFormTitle.textContent = activeItem.schema.title;
      }

      // Initialize form state
      currentFormData = {};
      activeItem.schema.fields.forEach((field) => {
        currentFormData[field.id] = field.defaultValue !== undefined ? field.defaultValue : (field.type === "checkbox" ? false : "");
      });

      // Render Dynamic Inputs
      if (dynamicFieldsTarget) {
        dynamicFieldsTarget.innerHTML = "";

        activeItem.schema.fields.forEach((field) => {
          const fieldGroup = document.createElement("div");
          fieldGroup.className = "dynamic-field-group";

          if (field.type === "text") {
            fieldGroup.innerHTML = `
              <label class="field-label" for="field-${field.id}">
                ${field.label} ${field.required ? '<span class="req-star">*</span>' : ''}
              </label>
              <input
                id="field-${field.id}"
                type="text"
                class="field-input"
                placeholder="${field.placeholder || ''}"
                value="${currentFormData[field.id] || ''}"
                data-field-id="${field.id}"
              />
            `;
          } else if (field.type === "select") {
            const optionsHtml = (field.options || [])
              .map((opt) => `<option value="${opt}" ${opt === currentFormData[field.id] ? "selected" : ""}>${opt}</option>`)
              .join("");
            fieldGroup.innerHTML = `
              <label class="field-label" for="field-${field.id}">
                ${field.label}
              </label>
              <div class="select-wrap">
                <select id="field-${field.id}" class="field-select" data-field-id="${field.id}">
                  ${optionsHtml}
                </select>
              </div>
            `;
          } else if (field.type === "range") {
            const val = currentFormData[field.id] || field.min || 1;
            fieldGroup.innerHTML = `
              <div class="slider-header">
                <label class="field-label" for="field-${field.id}">${field.label}</label>
                <span class="font-mono slider-val" id="val-${field.id}">${val}</span>
              </div>
              <input
                id="field-${field.id}"
                type="range"
                class="field-range"
                min="${field.min || 1}"
                max="${field.max || 100}"
                value="${val}"
                data-field-id="${field.id}"
              />
            `;
          } else if (field.type === "checkbox") {
            const isChecked = Boolean(currentFormData[field.id]);
            fieldGroup.innerHTML = `
              <label class="checkbox-label" for="field-${field.id}">
                <input
                  id="field-${field.id}"
                  type="checkbox"
                  class="field-checkbox"
                  ${isChecked ? "checked" : ""}
                  data-field-id="${field.id}"
                />
                <span class="custom-checkbox"></span>
                <span class="checkbox-text">${field.label}</span>
              </label>
            `;
          }

          dynamicFieldsTarget.appendChild(fieldGroup);
        });

        attachInputListeners();
        updateStateDisplay();
        if (feedbackToast) feedbackToast.style.display = "none";
      }
    }

    function attachInputListeners() {
      if (!dynamicFieldsTarget) return;

      const inputs = dynamicFieldsTarget.querySelectorAll("input, select");
      inputs.forEach((input) => {
        const fieldId = input.getAttribute("data-field-id");
        if (!fieldId) return;

        const handler = () => {
          if (input.type === "checkbox") {
            currentFormData[fieldId] = (input).checked;
          } else if (input.type === "range") {
            currentFormData[fieldId] = Number(input.value);
            const valBadge = document.getElementById(`val-${fieldId}`);
            if (valBadge) valBadge.textContent = input.value;
          } else {
            currentFormData[fieldId] = input.value;
          }
          updateStateDisplay();
        };

        input.addEventListener("input", handler);
        input.addEventListener("change", handler);
      });
    }

    function updateStateDisplay() {
      if (liveStateDisplay) {
        liveStateDisplay.textContent = JSON.stringify(currentFormData, null, 2);
      }
    }

    // Tab buttons click
    presetButtons.forEach((btn, index) => {
      btn.addEventListener("click", () => {
        renderSchema(index);
      });
    });

    // Submit Simulation
    submitBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      if (feedbackToast && feedbackStateJson) {
        feedbackStateJson.textContent = `Payload: ${JSON.stringify(currentFormData)}`;
        feedbackToast.style.display = "flex";
        feedbackToast.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    });

    // Reset Form
    resetBtn?.addEventListener("click", () => {
      renderSchema(currentSchemaIndex);
    });

    // Initialize first schema
    renderSchema(0);
  });
</script>

<style>
  .demo-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 3rem 0;
  }

  .demo-header-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .demo-pill-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .demo-container {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
  }

  .demo-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .demo-tabs-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .preset-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .preset-btn {
    padding: 0.4rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .preset-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .preset-btn.active {
    background: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.4);
  }

  /* Dual Pane Workspace */
  .demo-workspace {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: 380px;
  }

  .schema-pane {
    background: #090a0f;
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
  }

  [data-theme="light"] .schema-pane {
    background: #0f172a;
    color: #f8fafc;
  }

  .engine-pane {
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .pane-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .dot-red { width: 9px; height: 9px; border-radius: 50%; background: #ef4444; }
  .dot-yellow { width: 9px; height: 9px; border-radius: 50%; background: #f59e0b; }
  .dot-green { width: 9px; height: 9px; border-radius: 50%; background: #10b981; }

  .pane-name {
    margin-left: 0.4rem;
  }

  .schema-tag {
    font-size: 0.7rem;
    color: #64748b;
  }

  .schema-code-block {
    margin: 0;
    padding: 1.25rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: #38bdf8;
    overflow-x: auto;
    flex: 1;
    max-height: 420px;
  }

  .engine-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .dynamic-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .fields-target {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dynamic-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .req-star {
    color: var(--accent-rose);
  }

  .field-input,
  .field-select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md);
    background: var(--bg-input);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: all var(--transition-fast);
  }

  .field-input:focus,
  .field-select:focus {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-val {
    font-size: 0.8rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  .field-range {
    width: 100%;
    accent-color: var(--accent-primary);
    cursor: pointer;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    user-select: none;
  }

  .field-checkbox {
    accent-color: var(--accent-primary);
    width: 17px;
    height: 17px;
    cursor: pointer;
  }

  .checkbox-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .form-actions-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .feedback-toast {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--accent-emerald);
    animation: fadeIn 0.3s ease;
  }

  .toast-icon {
    font-weight: 800;
    font-size: 1.1rem;
  }

  .toast-content strong {
    font-size: 0.85rem;
    display: block;
  }

  .toast-content p {
    color: var(--text-secondary);
    margin-top: 0.2rem;
    word-break: break-all;
  }

  /* Live State Footer */
  .demo-state-footer {
    background: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-subtle);
    padding: 0.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .state-inspector-title {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .state-preview {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: pre-wrap;
    word-break: break-all;
  }

  /* Architecture Notes Strip */
  .architecture-notes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .arch-note-card {
    padding: 1.25rem;
    display: flex;
    gap: 0.85rem;
    background: var(--bg-card);
  }

  .arch-note-icon {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-primary);
    background: var(--accent-glow);
    height: 28px;
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .arch-note-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .arch-note-content h4 {
    font-size: 0.925rem;
    color: var(--text-primary);
  }

  .arch-note-content p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .demo-workspace {
      grid-template-columns: 1fr;
    }

    .schema-pane {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
    }

    .architecture-notes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
