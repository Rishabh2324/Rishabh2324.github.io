---
import type { ExperienceItem } from "../data/portfolioData";

interface Props {
  experiences: ExperienceItem[];
  showAll?: boolean;
}

const { experiences, showAll = true } = Astro.props;
---

<div class="timeline-container">
  <div class="timeline-line"></div>

  <div class="timeline-items">
    {
      experiences.map((exp, index) => (
        <div class={`timeline-card-wrapper ${exp.current ? "is-current" : ""}`} id={`exp-${exp.id}`}>
          <!-- Milestone Node -->
          <div class="timeline-node">
            <div class="node-inner">
              {exp.current ? (
                <span class="status-dot"></span>
              ) : (
                <span class="node-dot"></span>
              )}
            </div>
          </div>

          <!-- Card Content -->
          <div class="timeline-content glass-card spotlight-card">
            <div class="timeline-header">
              <div class="role-company-info">
                <div class="role-title-row">
                  <h3 class="role-title">{exp.role}</h3>
                  {exp.current && <span class="badge badge-emerald">CURRENT ROLE</span>}
                </div>
                <div class="company-meta">
                  <span class="company-name">{exp.company}</span>
                  <span class="meta-separator">•</span>
                  <span class="period-text font-mono">{exp.period}</span>
                  <span class="meta-separator">•</span>
                  <span class="location-text">{exp.location}</span>
                </div>
              </div>
            </div>

            <!-- Role Summary -->
            <p class="role-summary">{exp.summary}</p>

            <!-- Key Achievements List -->
            <div class="achievements-section">
              <span class="achievements-label font-mono">KEY RESPONSIBILITIES &amp; IMPACT:</span>
              <ul class="achievements-list">
                {exp.achievements.map((item) => (
                  <li class="achievement-item">
                    <span class="bullet-indicator">▸</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Architecture & Tech Stack -->
            <div class="timeline-tags-footer">
              <div class="tech-tags-group">
                <span class="tag-category-label font-mono">Tech Stack:</span>
                {exp.techStack.map((tech) => (
                  <span class="tech-pill font-mono">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .timeline-container {
    position: relative;
    padding-left: 2.5rem;
    margin: 1.5rem 0;
  }

  .timeline-line {
    position: absolute;
    left: 12px;
    top: 24px;
    bottom: 40px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-primary) 0%, var(--accent-cyan) 60%, transparent 100%);
    opacity: 0.4;
  }

  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .timeline-card-wrapper {
    position: relative;
  }

  .timeline-node {
    position: absolute;
    left: -2.5rem;
    top: 24px;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .node-inner {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--bg-surface-elevated);
    border: 2px solid var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.4);
  }

  .is-current .node-inner {
    border-color: var(--accent-emerald);
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.5);
  }

  .node-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-primary);
  }

  .timeline-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .is-current .timeline-content {
    border-color: rgba(16, 185, 129, 0.25);
    background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-surface-elevated) 100%);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .role-company-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .role-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .role-title {
    font-size: 1.35rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .company-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    flex-wrap: wrap;
  }

  .company-name {
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .meta-separator {
    color: var(--border-medium);
  }

  .period-text {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .location-text {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .role-summary {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .achievements-section {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .achievements-label {
    font-size: 0.7rem;
    color: var(--accent-primary);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .achievements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .achievement-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .bullet-indicator {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .timeline-tags-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tech-tags-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-category-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }

  .tech-pill {
    font-size: 0.725rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .timeline-container {
      padding-left: 1.75rem;
    }
    .timeline-line {
      left: 6px;
    }
    .timeline-node {
      left: -1.75rem;
    }
    .timeline-content {
      padding: 1.25rem;
    }
  }
</style>
