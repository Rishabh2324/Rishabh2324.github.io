---
interface Props {
  title: string;
  description: string;
  year?: string;
  linkTo?: string;
  secondaryText?: string;
  className?: string;
}

const {
  title,
  description,
  year,
  linkTo = "#",
  secondaryText = "View details",
  className = "",
} = Astro.props;
---

<div class={`glass-card spotlight-card legacy-card ${className}`}>
  <div class="legacy-card-header">
    <h3 class="legacy-card-title">{title}</h3>
    {year && <span class="badge font-mono">{year}</span>}
  </div>
  <p class="legacy-card-desc">
    {description}
  </p>
  {
    linkTo && (
      <a href={linkTo} class="legacy-card-link">
        <span>{secondaryText}</span>
        <span> →</span>
      </a>
    )
  }
</div>

<style>
  .legacy-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
  }

  .legacy-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .legacy-card-title {
    font-size: 1.2rem;
    color: var(--text-primary);
  }

  .legacy-card-desc {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .legacy-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-top: 0.5rem;
  }

  .legacy-card-link:hover {
    color: var(--accent-cyan);
  }
</style>
