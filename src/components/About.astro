---
import { Image } from "astro:assets";
import profileImage from "../assets/profile-image.jpg";
import { metricsData, personalInfo } from "../data/portfolioData";

const metrics = metricsData.map((m) => {
  const [, num = m.value, suffix = ""] = m.value.match(/^([\d.]+)(.*)$/) ?? [];
  return { ...m, num, suffix };
});
---

<section id="about" class="section about" data-scene='{"x":-0.62,"y":0.42,"scale":0.42,"hue":0.18,"distort":0.22}'>
  <div class="container">
    <p class="eyebrow" data-reveal>(01) — About</p>

    <div class="about__grid">
      <figure class="about__photo" data-photo>
        <div class="about__photo-frame">
          <Image
            src={profileImage}
            alt={`Portrait of ${personalInfo.name}`}
            width={1000}
            widths={[400, 720, 1000]}
            sizes="(max-width: 900px) 80vw, 34vw"
            class="about__img"
            data-photo-img
          />
        </div>
        <figcaption class="mono">
          <span>{personalInfo.name}</span>
          <span>{personalInfo.yearsOfExperience} yrs · {personalInfo.location}</span>
        </figcaption>
      </figure>

      <div class="about__copy">
        <p class="about__statement" data-split="words">
          I build interfaces that build themselves. Config-driven engines, micro-frontends and design systems, turning
          weeks of repetitive UI work into minutes of JSON.
        </p>
        <p class="lead" data-reveal>{personalInfo.bio}</p>
        <div class="about__actions" data-reveal>
          <a href="#engine" class="btn" data-magnetic="0.25">
            <span data-magnetic-inner>See the engine run</span>
          </a>
          <a href={personalInfo.linkedin} target="_blank" rel="noopener" class="btn" data-magnetic="0.25">
            <span data-magnetic-inner>LinkedIn</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        </div>
      </div>
    </div>

    <ul class="metrics" data-reveal="stagger">
      {
        metrics.map((m) => (
          <li class="metric">
            <p class="metric__value">
              <span data-count={m.num}>{m.num}</span>
              <span class="metric__suffix serif">{m.suffix}</span>
            </p>
            <p class="metric__label">{m.label}</p>
            <p class="metric__sub mono">{m.sublabel}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .about__photo {
    position: sticky;
    top: 7rem;
  }

  .about__photo-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-raise);
  }

  .about__photo-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(6, 6, 8, 0.7));
    pointer-events: none;
  }

  .about__img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.08) brightness(0.92);
    transition: filter 1.2s var(--ease-out);
  }

  .about__photo:hover .about__img {
    filter: grayscale(0) contrast(1.02) brightness(1);
  }

  .about__photo figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 0.9rem;
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 0.5rem;
  }

  .about__statement {
    font-size: clamp(1.9rem, 3.9vw, 3.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--line);
  }

  .metric {
    padding: 2rem 1.5rem 0 0;
  }

  .metric + .metric {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .metric__value {
    display: flex;
    align-items: baseline;
    font-size: clamp(3rem, 6vw, 5.75rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .metric__suffix {
    color: var(--accent);
    font-size: 0.75em;
    margin-left: 0.04em;
  }

  .metric__label {
    margin-top: 1rem;
    font-weight: 500;
  }

  .metric__sub {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo {
      position: relative;
      top: 0;
      max-width: 420px;
    }

    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metric:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .metric:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 2rem;
    }
  }
</style>

<script>
  import { gsap, onReady, reducedMotion } from "../scripts/motion";

  onReady(() => {
    if (reducedMotion) return;
    const photo = document.querySelector<HTMLElement>("[data-photo]")!;
    const frame = photo.querySelector<HTMLElement>(".about__photo-frame")!;
    const img = photo.querySelector<HTMLElement>("[data-photo-img]")!;

    gsap.timeline({ scrollTrigger: { trigger: photo, start: "top 85%", once: true } })
      .fromTo(frame, { clipPath: "inset(100% 0% 0% 0% round 18px)" }, { clipPath: "inset(0% 0% 0% 0% round 18px)", duration: 1.6, ease: "expo.inOut" })
      .from(img, { scale: 1.35, duration: 2, ease: "expo.out" }, 0.2);

    gsap.fromTo(img, { yPercent: -8 }, {
      yPercent: 0,
      ease: "none",
      scrollTrigger: { trigger: photo.closest("section"), start: "top bottom", end: "bottom top", scrub: true },
    });
  });
</script>
