---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  size?: "sm" | "md" | "lg" | "xl";
}

const { src, alt = "Portrait of Rishabh Jain", size = "md" } = Astro.props;

const sizeMap: Record<NonNullable<Props["size"]>, number> = {
  sm: 96,
  md: 140,
  lg: 200,
  xl: 260,
};

const dimension = sizeMap[size];
---

<div class="profile-avatar" style={`--avatar-size: ${dimension}px;`}>
  <Image
    src={src}
    alt={alt}
    width={dimension * 2}
    height={dimension * 2}
    class="profile-avatar-img"
  />
</div>

<style>
  .profile-avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    padding: 4px;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    box-shadow: var(--shadow-lg);
  }

  .profile-avatar-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    border: 3px solid var(--bg-base);
    object-fit: cover;
  }
</style>
