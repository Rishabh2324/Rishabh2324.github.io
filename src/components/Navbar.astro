---
import { personalInfo } from "../data/portfolioData";

const links = [
  { href: "/#about", label: "About" },
  { href: "/#engine", label: "Engine" },
  { href: "/#work", label: "Work" },
  { href: "/#journey", label: "Journey" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="Rishabh Jain — home" data-magnetic="0.2">
      <svg class="nav__star" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0v24M0 12h24M3.5 3.5l17 17M20.5 3.5l-17 17" stroke="currentColor" stroke-width="2.4" />
      </svg>
      <span>Rishabh Jain</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          links.map((link, i) => (
            <li>
              <a href={link.href} class="roll" data-magnetic="0.15">
                <span class="roll__index mono">0{i + 1}</span>
                <span class="roll__text" data-text={link.label}>
                  {link.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__end">
      <span class="nav__clock mono" aria-label="Local time in India">
        <span class="nav__dot" aria-hidden="true"></span>IND <time data-clock>--:--</time>
      </span>
      <a href={`mailto:${personalInfo.email}`} class="btn btn--solid nav__cta" data-magnetic="0.3">
        <span data-magnetic-inner>Let's talk</span>
      </a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav__burger-line" aria-hidden="true"></span>
        <span class="nav__burger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav aria-label="Mobile">
    <ul class="menu__list">
      {
        links.map((link, i) => (
          <li class="menu__item">
            <a href={link.href} class="menu__link">
              <span class="mono">0{i + 1}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu__foot mono">
    <a href={personalInfo.github} target="_blank" rel="noopener">GitHub ↗</a>
    <a href={personalInfo.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    <a href={`mailto:${personalInfo.email}`}>Email ↗</a>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 1.1rem var(--gutter);
    pointer-events: none;
  }

  .nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    max-width: var(--max);
    margin-inline: auto;
  }

  .nav__inner > * {
    pointer-events: auto;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
  }

  .nav__star {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent);
    animation: spin 9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .nav__links ul {
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(10, 10, 14, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .roll {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.88rem;
    transition: background-color 0.4s var(--ease-out);
  }

  .roll:hover {
    background: rgba(242, 240, 234, 0.07);
  }

  .roll__index {
    font-size: 0.6rem;
    color: var(--muted);
  }

  .roll__text {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.2;
  }

  .roll__text::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--accent);
  }

  .roll__text,
  .roll__text::after {
    transition: transform 0.55s var(--ease-out);
  }

  .roll:hover .roll__text {
    transform: translateY(-100%);
  }

  .nav__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .nav__clock {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--fg-soft);
    letter-spacing: 0.06em;
  }

  .nav__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(200, 255, 77, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(200, 255, 77, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(200, 255, 77, 0);
    }
  }

  .nav__cta {
    padding: 0.7rem 1.2rem;
    font-size: 0.85rem;
  }

  .nav__burger {
    display: none;
    position: relative;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgba(10, 10, 14, 0.6);
    backdrop-filter: blur(10px);
  }

  .nav__burger-line {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 1.5px;
    background: var(--fg);
    transform: translateX(-50%);
    transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out);
  }

  .nav__burger-line:nth-child(2) {
    top: calc(50% - 3px);
  }

  .nav__burger-line:nth-child(3) {
    top: calc(50% + 3px);
  }

  .nav__burger[aria-expanded="true"] .nav__burger-line:nth-child(2) {
    top: 50%;
    transform: translateX(-50%) rotate(45deg);
  }

  .nav__burger[aria-expanded="true"] .nav__burger-line:nth-child(3) {
    top: 50%;
    transform: translateX(-50%) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7rem var(--gutter) 2rem;
    background: var(--bg-raise);
    clip-path: inset(0 0 100% 0);
  }

  .menu__list {
    display: grid;
    gap: 0.5rem;
  }

  .menu__item {
    overflow: hidden;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: clamp(2.75rem, 12vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .menu__link .mono {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0;
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.8rem;
    color: var(--fg-soft);
  }

  @media (max-width: 960px) {
    .nav__inner {
      grid-template-columns: 1fr auto;
    }

    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__burger {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .nav__clock {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, getLenis, onReady, reducedMotion } from "../scripts/motion";

  // Live India clock.
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" });
  const tickClock = () => clock && (clock.textContent = fmt.format(new Date()));
  tickClock();
  setInterval(tickClock, 15000);

  const nav = document.querySelector<HTMLElement>("[data-nav]")!;

  onReady(() => {
    if (!reducedMotion) {
      gsap.from(nav.querySelectorAll(".nav__inner > *"), { y: -30, opacity: 0, stagger: 0.08, duration: 1.2, delay: 0.5 });
    }
    // Hide on scroll down, reveal on scroll up.
    let hidden = false;
    ScrollTrigger.create({
      start: 0,
      end: "max",
      onUpdate(self) {
        const shouldHide = self.direction === 1 && self.scroll() > 200 && !menuOpen;
        if (shouldHide === hidden) return;
        hidden = shouldHide;
        gsap.to(nav, { yPercent: hidden ? -130 : 0, duration: 0.8, ease: "expo.out" });
      },
    });
  });

  // Mobile menu.
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const menu = document.querySelector<HTMLElement>("[data-menu]")!;
  let menuOpen = false;

  function setMenu(open: boolean) {
    if (open === menuOpen) return;
    menuOpen = open;
    toggle.setAttribute("aria-expanded", String(open));
    const lenis = getLenis();
    const links = menu.querySelectorAll(".menu__link");
    if (open) {
      menu.hidden = false;
      lenis?.stop();
      gsap.timeline()
        .to(menu, { clipPath: "inset(0 0 0% 0)", duration: 0.9, ease: "expo.inOut" })
        .fromTo(links, { yPercent: 110 }, { yPercent: 0, stagger: 0.06, duration: 1 }, "-=0.45")
        .fromTo(".menu__foot", { opacity: 0 }, { opacity: 1, duration: 0.6 }, "-=0.6");
    } else {
      lenis?.start();
      gsap.to(menu, {
        clipPath: "inset(0 0 100% 0)",
        duration: 0.7,
        ease: "expo.inOut",
        onComplete: () => {
          if (!menuOpen) menu.hidden = true;
        },
      });
    }
  }

  toggle.addEventListener("click", () => setMenu(!menuOpen));
  document.addEventListener("nav:close", () => setMenu(false));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));
</script>
