---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Overview" },
  { href: "/#interactive-demo", label: "Interactive Demo" },
  { href: "/projects", label: "Projects" },
  { href: "/experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="navbar-wrapper">
  <nav class="navbar glass-card" aria-label="Main Navigation">
    <!-- Brand Logo -->
    <a href="/" class="brand" aria-label="Rishabh Jain Home">
      <div class="brand-monogram">
        <span>RJ</span>
      </div>
      <div class="brand-text">
        <span class="brand-name">Rishabh Jain</span>
        <span class="brand-role">Frontend Engineer</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <div class="nav-links-wrap">
      <span class="tab-glide nav-glide" aria-hidden="true"></span>
      <ul class="nav-links">
        {
          navLinks.map((link) => {
            const isActive =
              link.href === "/"
                ? currentPath === "/"
                : !link.href.startsWith("/#") && currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class={`nav-link ${isActive ? "active" : ""}`}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <!-- Actions: Theme Toggle & Resume / Contact CTA -->
    <div class="nav-actions">
      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="Toggle visual theme"
        title="Toggle dark/light mode"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg
          class="sun-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg
          class="moon-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Desktop Contact CTA -->
      <a href="/#contact" class="btn btn-primary nav-cta">
        <span>Let's Talk</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="mobile-toggle icon-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-content glass-card">
      <ul class="mobile-nav-links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-nav-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-drawer-footer">
        <a href="/#contact" class="btn btn-primary" style="width: 100%;">
          Get in Touch
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";
  import { EASE, initHoverGlide, onReady, prefersReducedMotion } from "../scripts/motion-utils";

  // Navbar Interactivity
  function initNavbar() {
    // Theme toggle handling
    const themeToggleBtn = document.getElementById("theme-toggle");

    themeToggleBtn?.addEventListener("click", () => {
      const currentTheme = document.documentElement.getAttribute("data-theme") || "dark";
      const nextTheme = currentTheme === "dark" ? "light" : "dark";

      document.documentElement.setAttribute("data-theme", nextTheme);
      localStorage.setItem("theme", nextTheme);
    });

    // Desktop nav hover glide
    const navLinksWrap = document.querySelector<HTMLElement>(".nav-links-wrap");
    const navGlide = document.querySelector<HTMLElement>(".nav-glide");
    const navLinkEls = Array.from(document.querySelectorAll<HTMLElement>(".nav-link"));
    initHoverGlide(navLinksWrap, navGlide, navLinkEls);

    // Mobile menu toggle handling
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileDrawer = document.getElementById("mobile-drawer");
    const drawerContent = document.querySelector<HTMLElement>(".mobile-drawer-content");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");
    const drawerAnimatedEls = Array.from(
      document.querySelectorAll<HTMLElement>(".mobile-nav-link, .mobile-drawer-footer .btn")
    );
    const hamburgerLines = Array.from(
      mobileBtn?.querySelectorAll<HTMLElement>(".hamburger-line") ?? []
    );
    const [topLine, midLine, bottomLine] = hamburgerLines;
    const iconEase = "back.out(2)";

    const animateIcon = (open: boolean) => {
      if (prefersReducedMotion() || !topLine || !midLine || !bottomLine) return;
      if (open) {
        gsap.to(topLine, { y: 6, rotate: 45, duration: 0.4, ease: iconEase });
        gsap.to(midLine, { opacity: 0, x: -6, duration: 0.2, ease: EASE });
        gsap.to(bottomLine, { y: -6, rotate: -45, duration: 0.4, ease: iconEase });
      } else {
        gsap.to(topLine, { y: 0, rotate: 0, duration: 0.4, ease: iconEase });
        gsap.to(midLine, { opacity: 1, x: 0, duration: 0.2, ease: EASE });
        gsap.to(bottomLine, { y: 0, rotate: 0, duration: 0.4, ease: iconEase });
      }
    };

    const animateDrawerOpen = () => {
      if (prefersReducedMotion() || !drawerContent) return;
      gsap.fromTo(
        drawerContent,
        { opacity: 0, y: -14 },
        { opacity: 1, y: 0, duration: 0.35, ease: EASE }
      );
      gsap.fromTo(
        drawerAnimatedEls,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.4, stagger: 0.05, delay: 0.08, ease: EASE }
      );
    };

    const animateDrawerClose = () => {
      if (prefersReducedMotion() || !drawerContent) return;
      gsap.to(drawerAnimatedEls, { opacity: 0, y: 8, duration: 0.2, stagger: 0.03, ease: EASE });
      gsap.to(drawerContent, { opacity: 0, y: -10, duration: 0.25, ease: EASE });
    };

    const toggleMenu = (open?: boolean) => {
      const isOpen = open !== undefined ? open : mobileBtn?.getAttribute("aria-expanded") !== "true";
      mobileBtn?.setAttribute("aria-expanded", String(isOpen));
      mobileBtn?.classList.toggle("open", isOpen);
      mobileDrawer?.classList.toggle("open", isOpen);
      mobileDrawer?.setAttribute("aria-hidden", String(!isOpen));
      animateIcon(isOpen);
      if (isOpen) {
        document.body.style.overflow = "hidden";
        animateDrawerOpen();
      } else {
        document.body.style.overflow = "";
        animateDrawerClose();
      }
    };

    mobileBtn?.addEventListener("click", () => toggleMenu());

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => toggleMenu(false));
    });

    // Close on escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileDrawer?.classList.contains("open")) {
        toggleMenu(false);
      }
    });
  }

  onReady(initNavbar);
</script>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 1.25rem;
    pointer-events: none;
  }

  .navbar {
    pointer-events: auto;
    width: 100%;
    max-width: var(--container-max);
    height: 60px;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-glass);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  /* Brand Styling */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-monogram {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--gradient-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: -0.05em;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.4);
    transition: transform var(--transition-fast);
  }

  .brand:hover .brand-monogram {
    transform: scale(1.08) rotate(-4deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .brand-role {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  /* Nav Links */
  .nav-links-wrap {
    position: relative;
  }

  .nav-glide {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    opacity: 0;
    background: var(--bg-surface-elevated);
    border-radius: var(--radius-full);
    pointer-events: none;
    z-index: 0;
  }

  .nav-links {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.45rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: var(--bg-surface-elevated);
    font-weight: 600;
  }

  /* Action Buttons */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
    transform: translateY(-1px);
  }

  /* Sun / Moon Display */
  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  [data-theme="light"] .sun-icon {
    display: none;
  }
  [data-theme="light"] .moon-icon {
    display: block;
  }

  .nav-cta {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 8px;
  }

  .hamburger-line {
    width: 18px;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
  }

  /* JS (motion) animates the open/close transform on these lines. This
     fallback only kicks in when the user prefers reduced motion, since the
     script skips animating them in that case. */
  @media (prefers-reduced-motion: reduce) {
    .mobile-toggle.open .hamburger-line:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-toggle.open .hamburger-line:nth-child(2) {
      opacity: 0;
    }
    .mobile-toggle.open .hamburger-line:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .nav-actions .nav-cta {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-drawer {
      display: block;
      position: fixed;
      inset: 0;
      top: 80px;
      z-index: 99;
      padding: 1rem;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--transition-normal), visibility var(--transition-normal);
    }

    .mobile-drawer.open {
      pointer-events: auto;
      opacity: 1;
      visibility: visible;
    }

    .mobile-drawer-content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      background: var(--bg-surface);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
    }

    .mobile-nav-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mobile-nav-link {
      display: block;
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-secondary);
      border-radius: var(--radius-md);
      transition: all var(--transition-fast);
    }

    .mobile-nav-link:hover {
      color: var(--text-primary);
      background: var(--bg-surface-elevated);
    }
  }

  @media (max-width: 360px) {
    .brand-role {
      display: none;
    }
  }
</style>
