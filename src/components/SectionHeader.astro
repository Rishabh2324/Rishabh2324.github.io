---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  linkText?: string;
  linkHref?: string;
  className?: string;
}

const {
  badge,
  title,
  subtitle = "",
  align = "left",
  linkText,
  linkHref,
  className = "",
} = Astro.props;
---

<div class={`section-header align-${align} ${className}`} data-reveal>
  <div class="section-header-copy">
    {badge && <span class="badge badge-accent section-badge">{badge}</span>}
    <h2 class="section-title">{title}</h2>
    {subtitle && <p class="section-subtitle">{subtitle}</p>}
  </div>

  {
    linkText && linkHref && (
      <a href={linkHref} class="section-link">
        <span>{linkText}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .section-header.align-center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-header-copy {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 640px;
  }

  .align-center .section-header-copy {
    max-width: 560px;
    align-items: center;
  }

  .section-badge {
    align-self: flex-start;
  }

  .align-center .section-badge {
    align-self: center;
  }

  .section-title {
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-primary);
    white-space: nowrap;
    padding-bottom: 0.35rem;
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .section-link svg {
    transition: transform var(--transition-fast);
  }

  .section-link:hover {
    color: var(--accent-cyan);
    gap: 0.65rem;
  }

  .section-link:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 640px) {
    .section-header {
      align-items: flex-start;
    }
  }
</style>
