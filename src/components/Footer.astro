---
import { personalInfo } from "../data/portfolioData";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner mono">
    <span>© {year} {personalInfo.name}</span>
    <span class="footer__built">Built with Astro · GSAP · Three.js</span>
    <div class="footer__links">
      <a href={personalInfo.github} target="_blank" rel="noopener">GitHub</a>
      <a href={personalInfo.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href="#top" data-magnetic="0.3" class="footer__top" aria-label="Back to top">↑ Top</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--line);
    padding-block: 1.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer__links {
    display: flex;
    gap: 1.5rem;
  }

  .footer a {
    color: var(--fg-soft);
    transition: color 0.3s;
  }

  .footer a:hover {
    color: var(--accent);
  }
</style>
