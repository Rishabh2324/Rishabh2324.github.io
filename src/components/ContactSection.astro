---
import { personalInfo } from "../data/portfolioData";
---

<div class="contact-section-wrapper" id="contact">
  <div class="contact-card glass-card spotlight-card" data-reveal>
    <div class="contact-layout">
      <!-- Left Column: Narrative & Direct Outreach -->
      <div class="contact-info-col">
        <span class="badge badge-emerald">GET IN TOUCH</span>
        <h2 class="contact-title">
          Let's build something <span class="accent-gradient-text">exceptional</span> together.
        </h2>
        <p class="contact-desc">
          Whether you're looking for a Senior Frontend Engineer to lead UI architecture, scale a config-driven frontend platform, or elevate your design engineering team, I'd love to connect.
        </p>

        <!-- Direct Email Box -->
        <div class="email-box glass-card">
          <div class="email-box-meta">
            <span class="font-mono text-muted text-xs">DIRECT INBOX:</span>
            <a href={`mailto:${personalInfo.email}`} class="email-address font-mono">
              {personalInfo.email}
            </a>
          </div>
          <button
            id="contact-copy-email-btn"
            class="btn btn-primary email-copy-btn"
            data-email={personalInfo.email}
            aria-label="Copy email address"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="contact-copy-text">Copy</span>
          </button>
        </div>

        <!-- Social Channels Grid -->
        <div class="social-channels-row">
          <a
            href={personalInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-channel-card glass-card"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span>GitHub Profile</span>
          </a>

          <a
            href={personalInfo.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-channel-card glass-card"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            <span>LinkedIn Connect</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Quick Reach Out Form -->
      <div class="contact-form-col">
        <div class="quick-form-card glass-card">
          <h3 class="form-title">Send a Quick Note</h3>
          <p class="form-desc">Direct inquiry or project collaboration</p>

          <form id="portfolio-quick-contact-form" class="quick-form" onsubmit="return false;">
            <div class="form-field">
              <label for="contact-name" class="field-label">Your Name</label>
              <input type="text" id="contact-name" class="field-input" placeholder="e.g. Sarah Connor" required />
            </div>

            <div class="form-field">
              <label for="contact-email" class="field-label">Your Email</label>
              <input type="email" id="contact-email" class="field-input" placeholder="sarah@company.com" required />
            </div>

            <div class="form-field">
              <label for="contact-message" class="field-label">Message / Project Scope</label>
              <textarea id="contact-message" class="field-input textarea" rows="4" placeholder="Tell me about your team or project..." required></textarea>
            </div>

            <button type="submit" id="contact-submit-btn" class="btn btn-primary" style="width: 100%;">
              <span>Send Message</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>

            <div id="contact-form-feedback" class="form-success-note" style="display: none;">
              ✓ Opening default mail client with your prefilled message...
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { onReady } from "../scripts/motion-utils";

  function initContact() {
    // Copy button
    const copyBtn = document.getElementById("contact-copy-email-btn");
    copyBtn?.addEventListener("click", async () => {
      const email = copyBtn.getAttribute("data-email");
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        const textSpan = copyBtn.querySelector(".contact-copy-text");
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = "Copied!";
          setTimeout(() => {
            textSpan.textContent = original;
            copyBtn.classList.remove("copied");
          }, 2000);
        }
      } catch (err) {
        console.error(err);
      }
    });

    // Form handler
    const form = document.getElementById("portfolio-quick-contact-form");
    const feedback = document.getElementById("contact-form-feedback");
    
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = (document.getElementById("contact-name") as HTMLInputElement)?.value;
      const email = (document.getElementById("contact-email") as HTMLInputElement)?.value;
      const message = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value;

      if (feedback) {
        feedback.style.display = "block";
      }

      const subject = encodeURIComponent(`Portfolio Inquiry from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`);
      window.location.href = `mailto:rishabh2401jain@gmail.com?subject=${subject}&body=${body}`;
    });
  }

  onReady(initContact);
</script>

<style>
  .contact-section-wrapper {
    margin: 3.5rem 0 1rem 0;
  }

  .contact-card {
    padding: 2.5rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-surface-elevated) 100%);
    border: 1px solid var(--border-medium);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .contact-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    line-height: 1.15;
  }

  .contact-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .email-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .email-box-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .text-xs {
    font-size: 0.725rem;
  }

  .email-address {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .email-address:hover {
    color: var(--accent-cyan);
  }

  .email-copy-btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.8rem;
  }

  .social-channels-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .social-channel-card {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .social-channel-card:hover {
    color: var(--accent-primary);
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  /* Quick Form */
  .quick-form-card {
    padding: 1.75rem;
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
  }

  .form-title {
    font-size: 1.2rem;
    color: var(--text-primary);
  }

  .form-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .quick-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .field-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md);
    background: var(--bg-input);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: all var(--transition-fast);
  }

  .field-input.textarea {
    resize: vertical;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--border-focus);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form-success-note {
    font-size: 0.8rem;
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.12);
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    animation: fadeIn 0.3s ease;
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .contact-card {
      padding: 1.75rem;
    }
  }
</style>
