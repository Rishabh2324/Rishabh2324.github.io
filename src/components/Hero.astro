---
import { personalInfo } from "../data/portfolioData";
---

<section class="hero" data-scene='{"x":0.42,"y":0,"scale":1,"distort":0.24,"hue":0,"intensity":1}' aria-labelledby="hero-title">
  <div class="container hero__inner" data-hero-inner>
    <p class="eyebrow hero__eyebrow" data-hero-fade>Senior Frontend Engineer — {personalInfo.location}</p>

    <h1 class="hero__title" id="hero-title">
      <span class="sr-only">{personalInfo.name}</span>
      <span class="hero__line" data-hero-line aria-hidden="true">Rishabh</span>
      <span class="hero__line hero__line--two" data-hero-line aria-hidden="true">
        <span class="serif">Jain</span><span class="accent">.</span>
      </span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__lead" data-hero-fade>
        I architect <span class="serif accent">config-driven</span> UI platforms and high-performance web apps — interfaces
        that compile themselves from data.
      </p>

      <div class="hero__meta" data-hero-fade>
        {
          personalInfo.availableForHire && (
            <span class="hero__status chip">
              <span class="hero__status-dot" aria-hidden="true" />
              Open to high-impact roles
            </span>
          )
        }
        <a href="#about" class="hero__scroll mono" data-cursor="Scroll">
          <span>Scroll to explore</span>
          <span class="hero__scroll-line" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-block: 7rem 2.5rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4rem, min(16vw, 27svh), 16rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.065em;
    margin-left: -0.05em;
  }

  .hero__line {
    display: block;
    width: max-content;
    will-change: transform;
  }

  .hero__line--two {
    margin-left: 0.9em;
    margin-top: -0.04em;
  }

  .hero__line--two .serif {
    letter-spacing: -0.03em;
    padding-right: 0.04em;
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem;
    padding-top: clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    line-height: 1.45;
    color: var(--fg-soft);
    letter-spacing: -0.01em;
  }

  .hero__lead .serif {
    font-size: 1.12em;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .hero__status {
    gap: 0.55rem;
    padding: 0.55rem 0.95rem;
    background: rgba(10, 10, 14, 0.5);
    backdrop-filter: blur(10px);
  }

  .hero__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  .hero__scroll-line {
    position: relative;
    width: 4rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scan 2.2s var(--ease-in-out) infinite;
  }

  @keyframes scan {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  html.js [data-hero-fade],
  html.js [data-hero-line] {
    opacity: 0;
  }

  @media (max-width: 760px) {
    .hero {
      padding-bottom: 2rem;
    }

    .hero__bottom {
      grid-template-columns: 1fr;
    }

    .hero__meta {
      justify-content: space-between;
    }

    .hero__line--two {
      margin-left: 0.5em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js [data-hero-fade],
    html.js [data-hero-line] {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap, SplitText, onReady, reducedMotion } from "../scripts/motion";

  const hero = document.querySelector<HTMLElement>(".hero")!;
  const lines = Array.from(hero.querySelectorAll<HTMLElement>("[data-hero-line]"));
  const fades = hero.querySelectorAll<HTMLElement>("[data-hero-fade]");

  onReady(() => {
    if (reducedMotion) return;

    gsap.set(lines, { opacity: 1 });
    const split = SplitText.create(lines, { type: "lines,chars", mask: "lines", linesClass: "split-line" });

    gsap.timeline()
      .from(split.chars, { yPercent: 120, rotate: 8, duration: 1.5, stagger: 0.045, ease: "expo.out" }, 0.1)
      .fromTo(fades, { opacity: 0, y: 30 }, { opacity: 1, y: 0, stagger: 0.12, duration: 1.2 }, 0.6);

    // Scroll-out: the name drifts apart and the hero dissolves.
    const out = gsap.timeline({
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true },
    });
    out.to(lines[0], { xPercent: -14, ease: "none" }, 0)
      .to(lines[1], { xPercent: 10, ease: "none" }, 0)
      .to("[data-hero-inner]", { yPercent: 18, opacity: 0, ease: "none" }, 0);
  });
</script>
