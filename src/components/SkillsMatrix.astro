---
import { skillsData } from "../data/portfolioData";
---

<div class="skills-matrix-grid" id="skills" data-reveal-group>
  {
    skillsData.map((category) => (
      <div class="skill-category-card glass-card spotlight-card">
        <!-- Category Header -->
        <div class="category-card-header">
          <div class="category-icon-wrapper">
            {category.icon === "layers" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            )}
            {category.icon === "code" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            )}
            {category.icon === "palette" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
              </svg>
            )}
            {category.icon === "cpu" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="14" x2="23" y2="14"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="14" x2="4" y2="14"></line>
              </svg>
            )}
          </div>
          <div class="category-header-text">
            <h3 class="category-title">{category.title}</h3>
            <p class="category-desc">{category.description}</p>
          </div>
        </div>

        <!-- Skills List -->
        <div class="skills-chips-list">
          {
            category.skills.map((skill) => (
              <div class={`skill-chip ${skill.highlight ? "highlighted" : ""}`}>
                <span class="skill-name">{skill.name}</span>
                <span class="skill-level font-mono">{skill.level}</span>
              </div>
            ))
          }
        </div>
      </div>
    ))
  }
</div>

<style>
  .skills-matrix-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .skill-category-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    background: var(--bg-card);
    border-radius: var(--radius-xl);
  }

  .category-card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .category-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--accent-glow);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .category-header-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .category-title {
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .category-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .skills-chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    font-size: 0.825rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .skill-chip:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  .skill-chip.highlighted {
    border-color: rgba(99, 102, 241, 0.35);
    background: var(--bg-surface-hover);
    color: var(--text-primary);
  }

  .skill-name {
    font-weight: 500;
  }

  .skill-level {
    font-size: 0.675rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-weight: 600;
  }

  @media (max-width: 800px) {
    .skills-matrix-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
