---
import Layout from "../layouts/Layout.astro";
import Journey from "../components/Journey.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import { experienceData, personalInfo } from "../data/portfolioData";
---

<Layout title={`Experience — ${personalInfo.name}`} description="Career roadmap: UI architecture, Vue 3 re-platforming and frontend leadership.">
  <section class="section page-head" data-scene='{"x":0.48,"y":0.2,"scale":0.8,"hue":0.6,"intensity":1,"distort":0.3}'>
    <div class="container">
      <p class="eyebrow" data-reveal>Career roadmap — {personalInfo.yearsOfExperience} years</p>
      <h1 class="display page-head__title" data-split="chars">Experi<span class="serif">ence</span></h1>
      <p class="lead" data-reveal>
        {experienceData.length} roles across UI architecture, Vue 3 re-platforming, micro-frontends and full-stack delivery,
        from internship to leading frontend architecture.
      </p>
    </div>
  </section>

  <Journey full index="(01)" />
  <Skills />
  <Contact />
</Layout>

<style>
  .page-head {
    padding-top: clamp(9rem, 18vw, 14rem);
    padding-bottom: 0;
  }

  .page-head .container {
    display: grid;
    gap: 1.75rem;
  }

  .page-head__title {
    font-size: clamp(3.5rem, 14vw, 13rem);
  }
</style>
