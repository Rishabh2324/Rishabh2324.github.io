---
import Layout from "../layouts/Layout.astro";
import Section from "../layouts/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactSection from "../components/ContactSection.astro";

import { projectsData, personalInfo } from "../data/portfolioData";

const categories = [
  "All",
  "Architecture & Engines",
  "Web Applications",
  "Leadership & Community",
];
---

<Layout
  title={`Projects & Systems | ${personalInfo.name}`}
  description="Explore technical case studies, declarative UI platforms, and web applications built by Rishabh Jain."
>
  <Section spacing="sm">
    <!-- Page Breadcrumb & Header -->
    <div class="projects-page-hero">
      <a href="/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Overview</span>
      </a>

      <div class="page-title-block">
        <span class="badge badge-accent">PORTFOLIO SHOWCASE</span>
        <h1 class="page-title">
          Projects &amp; <span class="accent-gradient-text">Architectural Systems</span>
        </h1>
        <p class="page-subtitle">
          In-depth case studies, declarative form rendering engines, and production web applications built for scalability, high performance, and delightful user ergonomics.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="filter-tabs-wrapper">
        <div class="filter-tabs" role="tablist">
          {
            categories.map((cat, i) => (
              <button
                class={`filter-tab-btn ${i === 0 ? "active" : ""}`}
                data-category={cat}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- Projects Grid -->
  <Section spacing="sm">
    <div class="all-projects-grid" id="projects-grid">
      {
        projectsData.map((project) => (
          <div class="project-grid-item" data-category={project.category}>
            <ProjectCard project={project} featured={project.featured} />
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Outreach CTA -->
  <Section spacing="md">
    <ContactSection />
  </Section>
</Layout>

<script>
  // Project filtering logic
  document.addEventListener("DOMContentLoaded", () => {
    const filterBtns = document.querySelectorAll(".filter-tab-btn");
    const projectItems = document.querySelectorAll(".project-grid-item");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedCategory = btn.getAttribute("data-category");

        // Update active button state
        filterBtns.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");

        // Filter projects
        projectItems.forEach((item) => {
          const itemCategory = item.getAttribute("data-category");
          if (selectedCategory === "All" || itemCategory === selectedCategory) {
            (item as HTMLElement).style.display = "block";
            (item as HTMLElement).style.animation = "fadeIn 0.3s ease";
          } else {
            (item as HTMLElement).style.display = "none";
          }
        });
      });
    });
  });
</script>

<style>
  .projects-page-hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
    transform: translateX(-2px);
  }

  .page-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 800px;
  }

  .page-title {
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .filter-tabs-wrapper {
    margin-top: 0.5rem;
    padding-bottom: 0.5rem;
    overflow-x: auto;
  }

  .filter-tabs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
  }

  .filter-tab-btn {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .filter-tab-btn:hover {
    color: var(--text-primary);
    background: var(--bg-surface-elevated);
  }

  .filter-tab-btn.active {
    background: var(--accent-primary);
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.35);
  }

  .all-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  @media (max-width: 840px) {
    .all-projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
