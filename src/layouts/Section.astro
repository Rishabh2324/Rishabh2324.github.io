---
interface Props {
  id?: string;
  spacing?: "sm" | "md" | "lg";
  className?: string;
}

const { id, spacing = "md", className = "" } = Astro.props;
---

<section id={id} class={`Section spacing-${spacing} ${className}`}>
  <slot />
</section>

<style>
  .Section {
    padding: 2.5rem 0;
  }

  .spacing-sm {
    padding: 1.5rem 0;
  }

  .spacing-md {
    padding: 3rem 0;
  }

  .spacing-lg {
    padding: 4.5rem 0;
  }

  @media (max-width: 700px) {
    .spacing-md {
      padding: 2.25rem 0;
    }
    .spacing-lg {
      padding: 3rem 0;
    }
  }
</style>
